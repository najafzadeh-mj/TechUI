<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>TechUI.Mvc.EntityFrameworkCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Majid Najafzadeh</Authors>
    <Company>Ti1co</Company>
    <Description>Entity Framework Core integration for TechUI.Mvc (filtering, sorting and paging).</Description>
    <PackageTags>aspnetcore; mvc; grid; entityframeworkcore; efcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/najafzadeh-mj/TechUI</RepositoryUrl>
    <PackageProjectUrl>https://github.com/najafzadeh-mj/TechUI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechUI.Mvc\TechUI.Mvc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
  </ItemGroup>

</Project>
