@{
    ViewData["Title"] = "Breadcrumb";
}

<h1>مسیر راهنما / Breadcrumb</h1>
<p class="text-muted">
    مسیر صفحه به‌صورت کامل سمت سرور رندر می‌شود؛ بدون JavaScript. آخرین آیتم
    با <code>aria-current="page"</code> علامت می‌خورد، جداکننده در RTL برعکس
    می‌شود و رنگ‌ها از توکن‌های تم پیروی می‌کنند.
</p>

<div class="row g-4" dir="rtl" lang="fa">

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent">
                @(Html.Tech().Breadcrumb("shopBreadcrumb")
                    .Home("/")
                    .Item("فروشگاه", "#shop", "shop")
                    .Item("لوازم جانبی", "#accessories", "headphones")
                    .Item("هدفون بی‌سیم پرو", null, "earbuds"))
            </div>
            <div class="card-body">
                <h2 class="h5 mb-1">مسیر کامل با آیکن</h2>
                <p class="text-muted small mb-0">
                    اولین آیتم با <code>Home()</code> ساخته می‌شود؛ آیتم آخر بدون
                    لینک و به‌عنوان صفحهٔ جاری رندر می‌شود.
                </p>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-1">حالت فشرده و جداکنندهٔ سفارشی</h2>
                <p class="text-muted small mb-3">
                    <code>Compact()</code> فاصله‌ها را کم می‌کند و
                    <code>Separator("/")</code> جداکنندهٔ پیش‌فرض را جایگزین می‌کند.
                </p>

                @(Html.Tech().Breadcrumb("compactBreadcrumb")
                    .Compact()
                    .Separator("/")
                    .Home("/", "خانه", null)
                    .Item("سفارش‌ها", "#orders")
                    .Item("سفارش ۱۰۲۴", "#orders/1024")
                    .Item("جزئیات سفارش"))

                <p class="text-muted small mb-3 mt-4">
                    متن صفحهٔ جاری اگر طولانی باشد با نقطه‌چین کوتاه می‌شود و
                    به خط بعد نمی‌شکند.
                </p>

                @(Html.Tech().Breadcrumb("longBreadcrumb")
                    .Item("داشبورد", "#dashboard", "speedometer2")
                    .Item("گزارش‌های فروش", "#reports")
                    .Item("گزارش تفصیلی فروش محصولات در سه ماههٔ سوم سال ۱۴۰۵"))
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-1">مسیر کوتاه و بدون آیکن</h2>
                <p class="text-muted small mb-3">
                    آیتم‌های میانی می‌توانند فقط متن باشند؛ لینک اجباری نیست.
                </p>

                @(Html.Tech().Breadcrumb("simpleBreadcrumb")
                    .Item("حساب کاربری")
                    .Item("تنظیمات پروفایل", null)
                    .Item("امنیت"))

                <div class="border-top mt-4 pt-3">
                    <span class="text-muted small d-block mb-2">
                        نمونهٔ قرارگیری در هدر کارت
                    </span>

                    @(Html.Tech().Breadcrumb("headerBreadcrumb")
                        .Compact()
                        .Home("/", "خانه", "house-door")
                        .Item("پنل مدیریت", "#admin")
                        .Item("سفارش‌ها", "#admin/orders")
                        .Item("سفارش ۱۰۲۴"))
                </div>
            </div>
        </div>
    </div>

</div>
