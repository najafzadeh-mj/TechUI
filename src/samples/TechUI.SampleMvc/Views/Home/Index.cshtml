@model IEnumerable<TechUI.SampleMvc.Models.UserViewModel>
@using TechUI.SampleMvc.Models

@{
    ViewData["Title"] = "Home Page";
}


<h1>TechUI Grid Test</h1>
<button class="btn btn-success mt-3" onclick="refreshGrid()">
    Refresh Grid
</button>


<hr />

@Html.AntiForgeryToken()

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input id="txtCode"
               class="form-control"
               placeholder="کد" />
    </div>

    <div class="col-md-3">
        <input id="txtTitle"
               class="form-control"
               placeholder="عنوان" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100"
                onclick="Tech.Grid.get('usersGrid').refresh()">
            جستجو
        </button>
    </div>
</div>
<hr />
<div dir="rtl">
    @(Html.Tech().Grid<UserViewModel>()
        .Name("usersGrid")
        .DataSource(ds => ds.Read("GridData", "Home")
            .Type(TechHttpMethod.Post)
            .Data("searchGrid"))
        .Pageable()
        .Sortable()
        .Sort("Id", "desc")
        .PageSize(17)
        .Height(600)
        .Filterable()
        .MultiSelect()
        .Resizable()
        .Reorderable()
        .Summary(s => s.Count())
        .Group(g => g
            .By(x => x.IsActive, "وضعیت فعالیت")
            .By(x => x.Roles, "نقش"))
        .GroupPanel()
        .InfiniteScroll()
        .AriaLabel("جدول کاربران نمونه")
        //.PageSizeSelector()
        .PageSizes(10, 20, 50, 100, 200)
        .Events(e => e
            .Change("onGridChange")
            .RowClick("onGridRowClick")
            .RowDoubleClick("onGridRowDoubleClick"))
        .Toolbar(t =>
        {
            t.Create("افزودن", "onCreate");
            t.Refresh("بازخوانی");
            t.Export("خروجی CSV", "filetype-csv", "users.csv");
            t.ColumnChooser();
        })
        .Chat(c => c
            .Url(Url.Action("GridChat", "Home")!)
            .Title("دستیار Grid")
            .ButtonText("دستیار")
            .Placeholder("مثلاً: فیلتر نام کامل User 001")
            .Welcome("سلام! این صفحه نمونهٔ Grid است. دربارهٔ ستون‌های شناسه و نام کامل بپرسید.")
            .Suggestions(
                "تعداد کل را بگو",
                "فیلتر نام کامل User 001",
                "مرتب‌سازی بر اساس شناسه نزولی",
                "صفحه بعد",
                "ستون شناسه را مخفی کن",
                "نام کامل User 002 را هایلایت کن"))
        .Columns(c =>
        {
            c.Bound(x => x.Id)
            .Title("شناسه")
            .Filterable()
            .Width(100)
            .Pinned();

            c.Bound(x => x.FullName)
            .Title("نام کامل");
            c.Bound(x => x.IsActive)
            .Title("فعال")
            .Width(90);
            c.Template(
            "<a href='/Users/Edit/{{Id}}' class='btn btn-sm btn-primary'>ویرایش {{FullName}}</a>")
            .Title("عملیات")
            .Width(140);
            c.Template(@"
        {{ if (Id % 2 === 0) { }}
        <span class='badge bg-success'>زوج</span>
        {{ } else { }}
        <span class='badge bg-secondary'>فرد</span>
        {{ } }}
        ")
            .Title("نوع")
            .Width(120);
        c.Template(@"
        <strong>{{= FullName }}</strong>
        ")
            .Title("نام نمایشی");

        c.Template(@"
        {{ if (IsActive) { }}
        <span class='badge bg-success'>فعال</span>
        {{ } else { }}
        <span class='badge bg-danger'>غیرفعال</span>
        {{ } }}
        ")
            .Title("وضعیت");
            c.Template(@"
        {{ for (const r of Roles) { }}
        <span class='badge bg-info me-1'>{{= r }}</span>
        {{ } }}
        ")
            .Title("نقش‌ها");
            c.Template(@"
        {{= badge(Id % 2 === 0 ? 'زوج' : 'فرد',
        Id % 2 === 0 ? 'success' : 'secondary') }}
        ")
            .Title("نوع")
            .Width(120);
            c.Template(@"
        {{= formatNumber(Id * 12500) }} تومان
        ")
            .Title("مبلغ")
            .Width(150);
            c.Template(@"
        <div>{{= upper(FullName) }}</div>
        <div class='small text-muted'>{{= truncate(FullName, 6) }}</div>
        ")
            .Title("نام")
            .Width(220);
            c.Template(@"
        {{= currency(Id * 100000) }}
        ")
            .Title("قیمت");
        }))

</div>

<script>

    function searchGrid() {

        return {
            code: document.getElementById('txtCode').value,
            title: document.getElementById('txtTitle').value
        };
    }


    function onGridChange(e) {

        console.log('Selected rows:', e.selected || e.data);
    }

    function onGridRowClick(e) {

        console.log('RowClick:', e.index, e.data);
    }

    function onGridRowDoubleClick(e) {

        const name = e.data ? (e.data.FullName || e.data.fullName) : '';

        Tech.notify('دابل‌کلیک روی ردیف: ' + name, {
            type: 'info',
            title: 'RowDoubleClick'
        });
    }

    async function refreshGrid() 
    {

        const grid = Tech.Grid.get('usersGrid');

        await grid.refresh();

        //alert('Grid refreshed');
    }
    function onCreate() {
        alert('Create clicked');
    }

    
</script>
