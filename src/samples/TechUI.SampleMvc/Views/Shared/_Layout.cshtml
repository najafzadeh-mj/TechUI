<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechUI.SampleMvc</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
        }
    </style>



    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechUI.SampleMvc.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/_content/TechUI.Mvc/css/techui.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TechUI.SampleMvc</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="DropDownList">DropDownList</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Inputs">Inputs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Validation">Validation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="MultiSelect">MultiSelect</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Notifications">Notifications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Components">Components</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Charts">Charts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="TreeView">TreeView</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="DropDownTree">DropDownTree</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="FileUpload">FileUpload</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Wizard">Wizard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Timeline">Timeline</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Breadcrumb">Breadcrumb</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="DatePicker">DatePicker</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="DateRange">DateRange</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="TimePicker">TimePicker</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Editor">Editor</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Choice">Choices</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Modal">Modal</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Rtl">RTL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 align-self-center">
                        <select id="presetPicker"
                                class="form-select form-select-sm"
                                style="width: 9.5rem;"
                                aria-label="قالب رنگی">
                            <option value="default">آبی (پیش‌فرض)</option>
                            <option value="emerald">زمردی</option>
                            <option value="violet">بنفش</option>
                            <option value="rose">رز</option>
                            <option value="amber">کهربایی</option>
                            <option value="slate">خاکستری</option>
                        </select>
                        <button type="button" id="themeToggle"
                                class="btn btn-sm btn-outline-secondary">
                            تم تاریک
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TechUI.SampleMvc - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/_content/TechUI.Mvc/js/techui.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        Tech.addTemplateHelper('currency', value => {
            return new Intl.NumberFormat('fa-IR').format(value) + ' ریال';
        });
    </script>
    <script>
        (function () {
            const toggle = document.getElementById('themeToggle');
            const preset = document.getElementById('presetPicker');

            function syncChrome(theme, presetName) {
                document.documentElement.setAttribute('data-bs-theme', theme);

                if (preset && presetName) {
                    preset.value = presetName;
                }

                const navbar = document.querySelector('header .navbar');

                if (navbar) {
                    navbar.classList.toggle('bg-white', theme !== 'dark');
                    navbar.classList.toggle('navbar-dark', theme === 'dark');
                    navbar.classList.toggle('navbar-light', theme !== 'dark');
                }

                document.querySelectorAll('header .nav-link, header .navbar-brand')
                    .forEach(function (link) {
                        link.classList.toggle('text-dark', theme !== 'dark');
                        link.classList.toggle('text-light', theme === 'dark');
                    });

                if (toggle) {
                    toggle.textContent = theme === 'dark' ? 'تم روشن' : 'تم تاریک';
                }
            }

            document.addEventListener('tech:theme-changed', function (ev) {
                syncChrome(ev.detail.theme, ev.detail.preset);
            });

            syncChrome(Tech.theme.get(), Tech.theme.getPreset());

            if (toggle) {
                toggle.addEventListener('click', function () {
                    Tech.theme.toggle();
                });
            }

            if (preset) {
                preset.addEventListener('change', function () {
                    Tech.theme.setPreset(preset.value);
                });
            }
        })();
    </script>

</body>
</html>
